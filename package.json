{
  "name": "labkit-bml",
  "productName": "Labkit BML",
  "version": "1.18.1",
  "description": "Rekentools, standaardcurves, enzymkinetiek, PCR en gelfoto-editor voor het biomedisch lab",
  "author": "svgbml",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "dist": "tauri build",
    "web": "npx --yes serve web",
    "build": "python tools/build_validated.py && vite build && python tools/build.py",
    "check": "npm run build:vue && python tools/check.py",
    "check:quick": "npm run build:vue && python tools/check.py --quick",
    "build:vue": "vite build",
    "dev:vue": "vite build --watch"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "vue": "^3.5.13"
  }
}
